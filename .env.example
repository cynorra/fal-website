# Copy to .env for local work. Never commit .env.

# Build-time read access: just the project id. firestore.rules let anyone read
# published documents and nothing else, so the build needs no key.
# Leave empty to build from the content that ships in code (content/seed.json mirrors it).
FIREBASE_PROJECT_ID=

# Write access (service account JSON on one line). Only for `npm run content:push`
# and `npm run content:rules`. Bypasses the rules: never give it to the site build,
# Cloudflare, GitHub Actions or any client code.
FIREBASE_SERVICE_ACCOUNT=
