{
  "name": "horoscopes-and-charts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./patch-exfat.cjs node_modules/next/dist/bin/next dev",
    "build": "node --max-old-space-size=4096 -r ./patch-exfat.cjs node_modules/next/dist/bin/next build",
    "build:cf": "next build",
    "start": "node -r ./patch-exfat.cjs node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "sync": "node scripts/sync-content.mjs",
    "predev": "node scripts/sync-content.mjs",
    "prebuild": "node scripts/sync-content.mjs",
    "prebuild:cf": "node scripts/sync-content.mjs",
    "content:export": "tsx scripts/export-content.mjs",
    "content:push": "node scripts/push-content.mjs",
    "content:rules": "node scripts/deploy-rules.mjs",
    "test:pipeline": "tsx --test scripts/pipeline/selftest.ts",
    "generate": "tsx scripts/pipeline/generate.ts",
    "auto-publish": "tsx scripts/pipeline/auto-publish.ts",
    "pretest:pipeline": "node scripts/sync-content.mjs",
    "pregenerate": "node scripts/sync-content.mjs",
    "preauto-publish": "node scripts/sync-content.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@google/genai": "^2.32.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.5.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
